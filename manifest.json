{
  "manifest_version": 3,
  "name": "Group Share Assistant",
  "description": "Review a Facebook post and selected groups, then share sequentially through Facebook’s native composer.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "alarms"],
  "optional_host_permissions": ["https://www.facebook.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Group Share Assistant", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'" }
}
